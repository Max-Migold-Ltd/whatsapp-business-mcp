# WhatsApp MCP Server - Environment Variables
# Copy this file to .env and fill in your values.
# Get credentials from: https://developers.facebook.com/

# === REQUIRED ===
META_ACCESS_TOKEN=your_meta_access_token_here
META_PHONE_NUMBER_ID=your_phone_number_id_here

# === RECOMMENDED ===
META_BUSINESS_ACCOUNT_ID=your_business_account_id_here
WABA_ID=your_waba_id_here
META_APP_ID=your_app_id_here

# === OPTIONAL ===
META_BUSINESS_PORTFOLIO_ID=your_portfolio_id_here
WHATSAPP_API_VERSION=v22.0

# === SECURITY (for HTTP server mode) ===
# App secret for verifying webhook signatures (X-Hub-Signature-256)
META_APP_SECRET=your_app_secret_here

# API key for authenticating HTTP API requests (X-API-Key header)
# If not set, API key auth is disabled (dev mode)
MCP_API_KEY=

# Comma-separated list of allowed CORS origins (e.g., https://example.com,https://app.example.com)
# If not set, CORS is disabled (no cross-origin requests allowed)
ALLOWED_ORIGINS=

# Directory where media uploads are allowed from (path traversal protection)
MEDIA_UPLOAD_DIR=/tmp/whatsapp-media/

# HTTP server port (default: 8080)
PORT=8080
# Address to listen on (default: 0.0.0.0). Use 127.0.0.1 behind a reverse proxy on the same machine
# (the systemd service in deploy/ sets this for you)
HOST=0.0.0.0

# Optional (stdio MCP mode): JSON file of contacts exposed as resource://contacts
# CONTACTS_FILE=

# === CUSTOMER SUPPORT BOT (webhook + questionnaire + agent handoff) ===
# Any random string; enter the same value as "Verify token" in Meta App Dashboard > WhatsApp > Configuration
WEBHOOK_VERIFY_TOKEN=
# Hours without an agent reply before the bot takes over a conversation again
AGENT_IDLE_HOURS=12
# Hours of customer silence after which an unfinished questionnaire starts over
GREETING_GAP_HOURS=24
# Timezone for the Date/Time column in the log (e.g. Africa/Lagos, Europe/London)
LOG_TIMEZONE=UTC
# Local database (source of truth for the Excel log)
SUPPORT_DB_PATH=data/support.db
# Optional: custom questionnaire file (default: support_bot/flow.json)
# SUPPORT_FLOW_FILE=

# === RELAY MODE (agent replies from their own WhatsApp) ===
# The agent's personal WhatsApp number with country code, e.g. 2348012345678.
# Leave empty if the agent uses the WhatsApp Business app on the same number (Coexistence).
AGENT_WHATSAPP_NUMBER=
# Optional: approved template that alerts the agent when forwards are waiting (24-hour rule)
AGENT_ALERT_TEMPLATE=
AGENT_ALERT_TEMPLATE_LANGUAGE=en

# === SHAREPOINT EXCEL LOG (Microsoft Graph, app-only) ===
# Leave empty to only log locally (export via /api/v1/support/export.csv)
SHAREPOINT_TENANT_ID=
SHAREPOINT_CLIENT_ID=
SHAREPOINT_CLIENT_SECRET=
# Either paste the file's SharePoint link ("Copy link" in SharePoint)...
SHAREPOINT_FILE_URL=
# ...or give its location:
# e.g. contoso.sharepoint.com
SHAREPOINT_HOSTNAME=
# e.g. /sites/CustomerService
SHAREPOINT_SITE_PATH=
# Path inside the site's "Documents" library, e.g. WhatsApp/Conversation Log.xlsx
SHAREPOINT_FILE_PATH=
SHAREPOINT_TABLE_NAME=Conversations
SHAREPOINT_TICKETS_TABLE=Tickets
EXCEL_SYNC_INTERVAL_SECONDS=15
