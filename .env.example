# WhatsApp MCP Server - Environment Variables
# Copy this file to .env and fill in your values.
# Get credentials from: https://developers.facebook.com/

# === REQUIRED ===
META_ACCESS_TOKEN=your_meta_access_token_here
META_PHONE_NUMBER_ID=your_phone_number_id_here

# === RECOMMENDED ===
META_BUSINESS_ACCOUNT_ID=your_business_account_id_here
WABA_ID=your_waba_id_here
META_APP_ID=your_app_id_here

# === OPTIONAL ===
META_BUSINESS_PORTFOLIO_ID=your_portfolio_id_here
WHATSAPP_API_VERSION=v22.0

# === SECURITY (for HTTP server mode) ===
# App secret for verifying webhook signatures (X-Hub-Signature-256)
META_APP_SECRET=your_app_secret_here

# API key for authenticating HTTP API requests (X-API-Key header)
# If not set, API key auth is disabled (dev mode)
MCP_API_KEY=

# Comma-separated list of allowed CORS origins (e.g., https://example.com,https://app.example.com)
# If not set, CORS is disabled (no cross-origin requests allowed)
ALLOWED_ORIGINS=

# Directory where media uploads are allowed from (path traversal protection)
MEDIA_UPLOAD_DIR=/tmp/whatsapp-media/

# HTTP server port (default: 8080)
PORT=8080
